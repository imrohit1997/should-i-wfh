# ─── Mapbox ───────────────────────────────────────────
MAPBOX_TOKEN=pk.your_mapbox_token_here

# ─── TomTom ───────────────────────────────────────────
TOMTOM_API_KEY=iUY0ZaPNX3Vo1dvFvErLpdigqQwsVJ0L

# ─── Open-Meteo ───────────────────────────────────────
# No key required — leave blank
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ─── Scraper ──────────────────────────────────────────
# How often (seconds) the Selenium scraper runs
SCRAPER_INTERVAL_SECONDS=900

# ─── App ──────────────────────────────────────────────
# Set to "true" to enable demo/mock data when API keys are absent
DEMO_MODE=false

# ─── CORS ─────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
